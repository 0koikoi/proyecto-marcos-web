# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - Proyecto Huellitas
# ============================================================
# 1. Copia este archivo y renómbralo a: .env
# 2. Rellena los valores con las credenciales reales de Neon
#    (pídelas al líder del equipo)
# 3. El archivo .env está en .gitignore → NUNCA se sube al repo
# ============================================================

# URL de la base de datos Neon (formato JDBC)
DB_URL=jdbc:postgresql://ep-polished-mouse-acdkdc5n.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Usuario de Neon
DB_USER=neondb_owner

# Contraseña de Neon (pídela al líder del equipo)
DB_PASS=PEDIR_AL_LIDER_DEL_EQUIPO
